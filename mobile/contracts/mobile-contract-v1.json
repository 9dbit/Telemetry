{
  "version": "telemetry-mobile/1",
  "milestone": "M1B-secure-offline-session-cross-platform-preview",
  "principles": {
    "offlineFirst": true,
    "stableIdentityInAdvertisement": false,
    "radioAddressPersisted": false,
    "cloudRequiredForDiscovery": false,
    "cloudRequiredForSession": false,
    "privateKeyLeavesDevice": false,
    "relayPayloadVisibility": "opaque",
    "manualSafetyCodeVerification": true
  },
  "stores": ["IdentityStore", "TrustStore", "ReplayStore", "MessageStore"],
  "interfaces": ["TransportAdapter", "PeerDiscovery", "PeerSession", "DeliveryReceipt"],
  "session": {
    "discovery": "ble",
    "bootstrap": "ble-gatt",
    "identitySigning": "Ed25519",
    "keyAgreement": "ephemeral-X25519",
    "kdf": "HKDF-SHA256",
    "payloadEncryption": "AES-256-GCM",
    "receiptSigning": "Ed25519",
    "maxTextUtf8Bytes": 160,
    "trustGate": "matching-safety-code"
  },
  "discoveryEvents": ["started", "peer-seen", "error", "stopped"],
  "android": {
    "minSdk": 26,
    "compileSdk": 37,
    "targetSdk": 36,
    "m1aTransport": "ble",
    "m1bTransport": "ble-gatt",
    "futureTransports": ["wifi-aware", "wifi-direct", "internet"]
  },
  "ios": {
    "minimumOs": "16.4",
    "trialRuntime": "expo-development-build",
    "uiLayer": "react-native",
    "nativeLayer": "swift-expo-module",
    "nativeCrypto": "CryptoKit",
    "m1Transport": "core-bluetooth-gatt",
    "trialDistribution": ["eas-internal", "testflight"],
    "wifiAware": {
      "minimumOs": 26,
      "minimumDevice": "iPhone 12",
      "status": "planned-m1c"
    },
    "futureTransports": ["wifi-aware", "network-framework", "internet"]
  }
}
