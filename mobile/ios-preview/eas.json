{
  "cli": {
    "version": ">= 19.1.0",
    "requireCommit": true,
    "appVersionSource": "local"
  },
  "build": {
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {}
  }
}
